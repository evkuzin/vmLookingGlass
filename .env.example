# Local build settings. Copy to .env; the file is not tracked.
#
#   cp .env.example .env
#
# make reads .env automatically, so `make` alone builds correctly on the
# corporate network.

# Corporate trust bundle. Outbound HTTPS is TLS-inspected with a cert chained
# to the private root CAs, which the build's base images do not trust. Leave it
# unset to build off-network.
BUILD_CA=/etc/ssl/certs/ca-certificates.crt

# Image tag used when building the runnable image.
# TAG=dev

# Registry to push to, if any.
# REGISTRY=registry.example/monitoring
