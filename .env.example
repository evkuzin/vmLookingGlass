# Local build settings. Copy to .env; the file is not tracked.
#
#   cp .env.example .env
#
# make reads .env automatically, so `make` alone builds correctly on the
# corporate network.

# Corporate trust bundle. Outbound HTTPS is TLS-inspected with a cert chained
# to the private root CAs, which the build's base images do not trust. Leave it
# unset to build off-network.
BUILD_CA=/etc/ssl/certs/ca-certificates.crt

# npm mirror, for networks where registry.npmjs.org is unreachable. npm
# rewrites the lock file's registry.npmjs.org URLs to it, so the lock file
# itself does not change. Leave unset for the public registry.
# NPM_REGISTRY=https://verdaccio.hudson-trading.com/

# Go module mirror. The URL carries a short-lived token, so it is exchanged
# fresh on every build and passed to the container build as a secret; the
# token never reaches the command line, an image layer or the build history.
# Leave unset for proxy.golang.org.
# GOPROXY_URL=$(shell set -e; token=$$(curl -sSf --cert /var/run/usercerts/$$USER.crt --key /var/run/usercerts/$$USER.key https://goproxy.hudson-trading.com/auth/token); echo https://$$USER:$$token@goproxy.hudson-trading.com)

# The container tool, and flags every invocation gets. podman needs --cert-dir
# to trust the Harbor registry proxy from some hosts; docker needs none.
# DOCKER = podman
# DOCKER_FLAGS = --cert-dir /usr/tmp/claude-evgeny/certdir

# Where `make image` puts the runnable image and `make push` publishes it.
# VERSION defaults to `git describe --tags --always --dirty`; a release passes
# VERSION=0.1.0 explicitly.
# IMAGE = harbor.hudson-trading.com/database/vmlookingglass
# VERSION = 0.1.0
